# Plantilla de variables de entorno para ejecución local con docker compose.
# Copiar a .env y completar con valores propios. El archivo .env NO se versiona.
#
#   cp .env.example .env
#
# En los ambientes de nube estos valores no vienen de un archivo: se inyectan
# desde el gestor de secretos del proveedor.

# PostgreSQL
# POSTGRES_USER debe coincidir con el usuario referenciado en init-db.sql.
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=

# Panel de administración
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET=
